            },
            "description": "Get build logs."
          },
          "response": []
        },
        {
          "name": "Get build upload URL.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/builds/upload-url",
              "host": ["{{baseUrl}}"],
              "path": ["builds", "upload-url"]
            },
            "description": "Get a pre-signed URL for uploading build context."
          },
          "response": []
        }
      ]
    },
    {
